#jinja2: trim_blocks:True,lstrip_blocks:True
# etcd environment file — managed by Ansible
# Generated for: {{ inventory_hostname }} ({{ ip }})

ETCD_NAME={{ ansible_hostname }}
ETCD_DATA_DIR=/var/lib/etcd

# Client URLs
ETCD_LISTEN_CLIENT_URLS=http://0.0.0.0:2379
ETCD_ADVERTISE_CLIENT_URLS=http://{{ ip }}:2379

# Peer URLs
ETCD_LISTEN_PEER_URLS=http://0.0.0.0:2380
ETCD_INITIAL_ADVERTISE_PEER_URLS=http://{{ ip }}:2380

# Cluster bootstrap (initial formation only — ignored if data-dir already exists)
ETCD_INITIAL_CLUSTER={% for host in groups['all'] %}{{ host }}=http://{{ hostvars[host]['ip'] }}:2380{% if not loop.last %},{% endif %}{% endfor %}

ETCD_INITIAL_CLUSTER_STATE=new
ETCD_INITIAL_CLUSTER_TOKEN={{ patroni_cluster_name }}-etcd

# Tuning
ETCD_HEARTBEAT_INTERVAL=100
ETCD_ELECTION_TIMEOUT=1000
ETCD_AUTO_COMPACTION_RETENTION=1
ETCD_SNAPSHOT_COUNT=5000

# Logging
ETCD_LOG_LEVEL=info
