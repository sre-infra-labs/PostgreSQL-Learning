#jinja2: trim_blocks:True,lstrip_blocks:True
---

scope: {{ patroni_cluster_name }}
name: {{ ansible_facts['hostname'] }}
namespace: /service

log:
  level: {{ patroni_log_level | upper }}
  traceback_level: {{ patroni_log_traceback_level | upper }}
  format: "{{ patroni_log_format }}"
  dateformat: "{{ patroni_log_dateformat }}"
  max_queue_size: {{ patroni_log_max_queue_size | int }}
  dir: {{ patroni_log_dir }}
  file_num: {{ patroni_log_file_num | int }}
  file_size: {{ patroni_log_file_size | int }}
  loggers:
    patroni.postmaster: {{ patroni_log_loggers_patroni_postmaster | upper }}
    urllib3: {{ patroni_log_loggers_urllib3 | upper }}

restapi:
  listen: 0.0.0.0:{{ patroni_restapi_port }}
  connect_address: {{ ip }}:{{ patroni_restapi_port }}

# etcd3 DCS configuration
etcd3:
  {% if inventory_hostname in groups['standby_cluster'] %}
  # Standby cluster: etcd endpoints for all active standby nodes
  {% set _standby_all = groups['standby_cluster_leader'] + groups['standby_cluster_replica'] %}
  hosts: {{ _standby_all | map('extract', hostvars, 'ip') | product([':2379']) | map('join') | join(',') }}
  {% else %}
  # Primary cluster: etcd endpoints for all active primary nodes
  {% set _primary_all = groups['primary_cluster_leader'] + groups['primary_cluster_replica'] %}
  hosts: {{ _primary_all | map('extract', hostvars, 'ip') | product([':2379']) | map('join') | join(',') }}
  {% endif %}
  protocol: http

bootstrap:
  method: {{ patroni_cluster_bootstrap_method }}
  dcs:
    ttl: {{ patroni_ttl | d(30, true) | int }}
    loop_wait: {{ patroni_loop_wait | d(10, true) | int }}
    retry_timeout: {{ patroni_retry_timeout | d(10, true) | int }}
    maximum_lag_on_failover: {{ patroni_maximum_lag_on_failover | d(1048576, true) | int }}
    master_start_timeout: {{ patroni_master_start_timeout | d(300, true) | int }}
    synchronous_mode: {{ synchronous_mode | string | d('false', true) | lower }}
    synchronous_mode_strict: {{ synchronous_mode_strict | string | d('false', true) | lower }}
    synchronous_node_count: {{ synchronous_node_count | d(1, true) | int }}
    postgresql:
      use_pg_rewind: {{ patroni_postgresql_use_pg_rewind | string | d('false', true) | lower }}
      use_slots: true
      parameters:
      {% for parameter in postgresql_parameters if parameter is mapping and 'option' in parameter and 'value' in parameter %}
        {{ parameter.option }}: "{{ parameter.value }}"
      {% endfor %}
    {% if patroni_standby_cluster is defined and patroni_standby_cluster.host is defined and patroni_standby_cluster.host | length > 0 %}
    standby_cluster:
      host: {{ patroni_standby_cluster.host }}
      port: {{ patroni_standby_cluster.port | default(5432) }}
      {% if (patroni_standby_cluster.primary_slot_name | default(patroni_standby_primary_slot_name)) | length > 0 %}
      primary_slot_name: "{{ patroni_standby_cluster.primary_slot_name | default(patroni_standby_primary_slot_name) }}"
      {% endif %}
      {% if patroni_standby_cluster.restore_command is defined and patroni_standby_cluster.restore_command | length > 0 %}
      restore_command: "{{ patroni_standby_cluster.restore_command }}"
      {% endif %}
    {% endif %}

  initdb:
    - encoding: {{ postgresql_encoding }}
    - locale: {{ postgresql_locale }}
    - data-checksums

  pg_hba:
    # Local connections (superuser via unix socket)
    - local all postgres                           peer
    - host  all all      127.0.0.1/32              {{ postgresql_password_encryption_algorithm }}
    # Cluster-internal replication (all container IPs)
    {% for host in groups['all'] %}
    - host replication replicator {{ hostvars[host].ip }}/32 scram-sha-256
    {% endfor %}
    # Wide-open for Docker learning environment — restrict in production
    - host replication replicator 0.0.0.0/0        scram-sha-256
    - host all          all       0.0.0.0/0         scram-sha-256
    - host all          all       ::/0              scram-sha-256

  users:
    {{ patroni_superuser_username }}:
      password: "{{ patroni_superuser_password }}"
      options:
        - createrole
        - createdb
    {{ patroni_replication_username }}:
      password: "{{ patroni_replication_password }}"
      options:
        - replication


postgresql:
  listen: 0.0.0.0:{{ postgresql_port }}
  connect_address: {{ ip }}:{{ postgresql_port }}
  use_unix_socket: true
  data_dir: {{ postgresql_data_dir }}
  bin_dir: {{ postgresql_bin_dir }}
  config_dir: {{ postgresql_conf_dir }}
  pgpass: {{ postgresql_home_dir }}/.pgpass

  authentication:
    replication:
      username: {{ patroni_replication_username }}
      password: "{{ patroni_replication_password }}"
    superuser:
      username: {{ patroni_superuser_username }}
      password: "{{ patroni_superuser_password }}"

  parameters:
    unix_socket_directories: {{ postgresql_unix_socket_dir }}

  callbacks:
    on_role_change: /usr/local/bin/patroni_pgbouncer_callback.sh

  remove_data_directory_on_rewind_failure: {{ patroni_remove_data_directory_on_rewind_failure | string | d('false', true) | lower }}
  remove_data_directory_on_diverged_timelines: {{ patroni_remove_data_directory_on_diverged_timelines | string | d('true', true) | lower }}

  create_replica_methods:
  {% for method in patroni_create_replica_methods %}
    - {{ method }}
  {% endfor %}

  {% if 'pgbackrest' in patroni_create_replica_methods and pgbackrest is defined %}
  pgbackrest:
    {% for item in pgbackrest if item is mapping %}
    {{ item.option }}: {{ item.value }}
    {% endfor %}
  {% endif %}

  {% if 'basebackup' in patroni_create_replica_methods and basebackup is defined %}
  basebackup:
    {% for item in basebackup if item is mapping %}
    {{ item.option }}: '{{ item.value }}'
    {% endfor %}
  {% endif %}

{% if postgresql_restore_command is defined and postgresql_restore_command | length > 0 %}
  recovery_conf:
    restore_command: "{{ postgresql_restore_command }}"
{% endif %}




watchdog:
  mode: {{ patroni_watchdog_mode }}  # off — Docker containers have no /dev/watchdog

tags:
  nofailover: false
  noloadbalance: false
  clonefrom: false
  nosync: {{ patroni_tag_nosync | default(false) | lower }}
