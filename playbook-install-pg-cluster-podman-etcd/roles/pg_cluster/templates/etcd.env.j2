#jinja2: trim_blocks:True,lstrip_blocks:True
# etcd environment file — managed by Ansible
# Generated for: {{ inventory_hostname }} ({{ ip }})

ETCD_NAME={{ ansible_facts['hostname'] }}
ETCD_DATA_DIR=/var/lib/etcd

# Client URLs
ETCD_LISTEN_CLIENT_URLS=http://0.0.0.0:2379
ETCD_ADVERTISE_CLIENT_URLS=http://{{ ip }}:2379

# Peer URLs
ETCD_LISTEN_PEER_URLS=http://0.0.0.0:2380
ETCD_INITIAL_ADVERTISE_PEER_URLS=http://{{ ip }}:2380

# Cluster membership list
# When joining an existing cluster (playbook-add-replicas.yml), etcd_initial_cluster_override
# is set to the EXACT current registered members captured via `etcdctl member list`.
# Using the full inventory list would include future nodes not yet registered, causing etcd
# to refuse to start with "re-configuration failed due to not enough started members".
{% if etcd_initial_cluster_override is defined and etcd_initial_cluster_override %}
# Joining existing cluster — members captured at registration time
ETCD_INITIAL_CLUSTER={{ etcd_initial_cluster_override }}
{% elif inventory_hostname in groups['standby_cluster'] %}
{% set _standby_all = groups['standby_cluster_leader'] + groups['standby_cluster_replica'] %}
# Standby cluster fresh bootstrap: all standby nodes
ETCD_INITIAL_CLUSTER={% for host in _standby_all %}{{ host }}=http://{{ hostvars[host]['ip'] }}:2380{% if not loop.last %},{% endif %}{% endfor %}

{% else %}
{% set _primary_all = groups['primary_cluster_leader'] + groups['primary_cluster_replica'] %}
# Primary cluster fresh bootstrap: all primary nodes
ETCD_INITIAL_CLUSTER={% for host in _primary_all %}{{ host }}=http://{{ hostvars[host]['ip'] }}:2380{% if not loop.last %},{% endif %}{% endfor %}

{% endif %}
# 'new'      — all members start together (fresh install via playbook-install-*.yml)
# 'existing' — this node joins a running cluster (playbook-add-replicas.yml sets
#              etcd_cluster_state=existing and pre-registers via etcdctl member add)
ETCD_INITIAL_CLUSTER_STATE={{ etcd_cluster_state | default('new') }}
ETCD_INITIAL_CLUSTER_TOKEN={{ patroni_cluster_name }}-etcd

# Tuning
ETCD_HEARTBEAT_INTERVAL=100
ETCD_ELECTION_TIMEOUT=1000
ETCD_AUTO_COMPACTION_RETENTION=1
ETCD_SNAPSHOT_COUNT=5000

# Logging
ETCD_LOG_LEVEL=info
