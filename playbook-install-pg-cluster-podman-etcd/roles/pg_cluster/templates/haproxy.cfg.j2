global
    log /dev/log local0
    log /dev/log local1 notice
    maxconn 4096
    daemon

defaults
    log     global
    mode    tcp
    retries 2
    timeout connect  5s
    timeout client  30s
    timeout server  30s
    timeout check    5s

#---------------------------------------------------------------------
# Stats page — http://{{ inventory_hostname }}:{{ haproxy_stats_port }}/
#---------------------------------------------------------------------
listen stats
    bind *:{{ haproxy_stats_port }}
    mode http
    stats enable
    stats uri /
    stats refresh 10s
    stats auth {{ haproxy_stats_user }}:{{ haproxy_stats_password }}
    stats show-legends
    stats show-node

#---------------------------------------------------------------------
# Write frontend (port {{ haproxy_write_port }}) — routes only to Patroni primary
#---------------------------------------------------------------------
frontend fe_write
    bind *:{{ haproxy_write_port }}
    default_backend be_write

backend be_write
    option httpchk GET /primary
    http-check expect status 200
    default-server inter 3s fall 3 rise 2 on-marked-down shutdown-sessions
{% for host in groups['all'] %}
    server {{ hostvars[host]['inventory_hostname'] }} {{ hostvars[host]['ip'] }}:{{ postgresql_port }} maxconn 100 check port {{ patroni_restapi_port }}
{% endfor %}

#---------------------------------------------------------------------
# Read frontend (port {{ haproxy_read_port }}) — routes to healthy replicas
#---------------------------------------------------------------------
frontend fe_read
    bind *:{{ haproxy_read_port }}
    default_backend be_read

backend be_read
    option httpchk GET /replica
    http-check expect status 200
    default-server inter 3s fall 3 rise 2 on-marked-down shutdown-sessions
{% for host in groups['all'] %}
    server {{ hostvars[host]['inventory_hostname'] }} {{ hostvars[host]['ip'] }}:{{ postgresql_port }} maxconn 100 check port {{ patroni_restapi_port }}
{% endfor %}
